SERVER_PORT=8080

# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=your_db_name

# Database Migration (Deprecated - Use golang-migrate instead)
# This option is no longer used. Use 'make migrate-up' to run migrations.
# Migration commands now use the same DB_* variables as the application.
# RUN_MIGRATION=true

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password
REDIS_DB=0

# OAuth2 Providers Configuration
# Note: For Google OAuth to work, you need to:
# 1. Create a project in Google Cloud Console
# 2. Enable Google+ API or People API
# 3. Create OAuth 2.0 credentials (Web application)
# 4. Add http://localhost:8080/api/v1/auth/callback/google to authorized redirect URIs
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URL=http://localhost:8080/api/v1/auth/callback/google

# GitHub OAuth2 Configuration
# 1. Go to GitHub Settings > Developer settings > OAuth Apps
# 2. Create a new OAuth App
# 3. Set Authorization callback URL to http://localhost:8080/api/v1/auth/callback/github
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
GITHUB_REDIRECT_URL=http://localhost:8080/api/v1/auth/callback/github

# Telegram OAuth2 Configuration
# 1. Create a bot via @BotFather on Telegram
# 2. Get bot token from @BotFather
# 3. Set domain with /setdomain command
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_REDIRECT_URL=http://localhost:8080/api/v1/auth/callback/telegram

# Logging Configuration
LOG_LEVEL=info
LOG_FORMAT=text
LOG_OUTPUT=stdout

# JWT Configuration
# 🚨 CRITICAL SECURITY: JWT_SECRET is REQUIRED and must be secure
# The JWT_SECRET is used to sign authentication tokens. A weak or default key
# allows attackers to forge tokens and gain admin access.
#
# REQUIREMENTS:
# - Must be at least 32 characters long
# - Must be cryptographically random
# - MUST NOT use the old default "your-super-secret-jwt-key"
# - Should be unique per environment
#
# Generate a secure key using one of these methods:
# - openssl rand -hex 32
# - head -c 32 /dev/urandom | base64
# - Use the built-in Go function: go run -c "fmt.Println(config.GenerateSecureJWTKey())"
#
# Example secure key (DO NOT USE THIS EXACT VALUE):
# JWT_SECRET=a1b2c3d4e5f6789012345678901234567890abcdefghijklmnopqrstuvwxyz1234
JWT_SECRET=REPLACE_WITH_SECURE_RANDOM_32PLUS_CHAR_KEY
JWT_EXPIRE_HOURS=24

# Server API Token Configuration
# Token for UniProxy server nodes to authenticate with the API
# Must be at least 20 characters long for security
# Generate a strong random token for production use
SERVER_API_TOKEN=your-server-api-token-at-least-20-chars-long

# ==========================================
# Additional Configuration Notes
# ==========================================
# 1. Invite Code System is enabled by default
# 2. Users can register with or without invite codes
# 3. Invite codes can be single-use or multi-use
# 4. Admin users can view invite code statistics
# 5. All endpoints require active user status
# 6. OAuth2 providers are optional - system works without them
# 7. Use HTTPS in production for security
# 8. Set appropriate CORS headers for your frontend domain